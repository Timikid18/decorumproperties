APP_NAME=DECORUM HOMES & PROPERTIES
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Production API subdomain (e.g. https://api.decorumproperties.ng) — used to
# build absolute storage image URLs and signed/absolute links.
APP_URL=https://api.decorumproperties.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins (your Vercel domain).
# e.g. https://decorumproperties.ng,https://www.decorumproperties.ng
FRONTEND_URLS=https://decorumproperties.ng

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Set these from the Hostinger panel (never share DB credentials).
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force secure (HTTPS-only) cookies in production.
SESSION_SECURE_COOKIE=true
# Sanctum/login uses bearer tokens (localStorage) not cookies, so SameSite=None
# is NOT required; keep 'lax' unless you rely on cookie-based auth.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Public uploads/listing images live under storage/app/public; run:
#   php artisan storage:link  (creates public/storage -> storage/app/public)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP settings from your Hostinger email account.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="decorumproperties.ng@gmail.com"
MAIL_FROM_NAME="DECORUM HOMES & PROPERTIES"
MAIL_ENCRYPTION=ssl

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
